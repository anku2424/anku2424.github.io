---
import type { CollectionEntry } from "astro:content";

type Props = {
  project: CollectionEntry<"projects">;
};

const { project } = Astro.props;
const href = `/projects/${project.slug}`;
---

<a href={href} class="card card-hover group block p-7">
  <div class="overflow-hidden rounded-2xl border border-ink-700/15 bg-white/45">
    <img
      src={project.data.image}
      alt={project.data.imageAlt ?? `${project.data.title} preview image`}
      loading="lazy"
      width="1200"
      height="700"
      class="aspect-[16/10] h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
    />
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-ink-600/80">
    <span class="font-medium text-ink-700">{project.data.client}</span>
    <span class="h-1 w-1 rounded-full bg-ink-600/35" aria-hidden="true"></span>
    <span>{project.data.kind}</span>
  </div>

  <h3 class="mt-3 text-2xl font-bold tracking-tight text-ink-700 group-hover:text-ink-500">
    {project.data.title}
  </h3>

  <p class="mt-4 text-sm leading-relaxed text-ink-600">{project.data.summary}</p>

  {project.data.tags?.length ? (
    <p class="mt-5 text-xs text-ink-600/80">
      {project.data.tags.slice(0, 4).join(" • ")}
    </p>
  ) : null}
</a>
