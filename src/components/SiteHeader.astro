---
const navItems = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" }
];

const socialItems = [
  { href: "https://www.linkedin.com", label: "in" },
  { href: "https://www.behance.net", label: "be" },
  { href: "https://x.com", label: "x" }
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? pathname === "/" : pathname.startsWith(href));
---

<header class="border-b border-ink-700/10">
  <div class="page-container py-7">
    <div class="grid items-center gap-4 md:grid-cols-[1fr_auto_1fr]">
      <a href="/" class="inline-flex items-baseline gap-2">
        <span class="font-display text-2xl font-bold tracking-tight text-ink-700">Ankush Goyal</span>
      </a>

      <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                "text-sm font-medium transition",
                isActive(item.href) ? "text-ink-700" : "text-ink-600 hover:text-ink-700"
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center justify-end gap-4 md:flex">
        {
          socialItems.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noreferrer"
              class="text-sm font-semibold uppercase tracking-wide text-ink-700/80 transition hover:text-ink-700"
              aria-label={item.label}
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </div>

    <details class="mt-3 md:hidden">
      <summary class="w-fit cursor-pointer list-none rounded-xl border border-ink-700/20 bg-white/45 px-3 py-2 text-sm font-medium text-ink-700">
        Menu
      </summary>
      <div class="mt-2 w-full overflow-hidden rounded-2xl border border-ink-700/15 bg-white/50">
        <nav class="p-2" aria-label="Mobile">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "block rounded-xl px-3 py-2 text-sm transition",
                  isActive(item.href) ? "bg-white/55 text-ink-700" : "text-ink-600 hover:bg-white/55 hover:text-ink-700"
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </details>
  </div>
</header>
